# OS & Editor files
.DS_Store
.vscode/*
tmp/*

# Zero Secrets Policy (NEVER commit credentials, keys, env files, cookies, or session DBs)
.env
.env.*
.env.local
.env.*.local
!.env.example
key-file-*.json
*service_account*.json
*sa*.json
*credentials*.json
*.key
*.pem
*.pkcs12
*cookies*
.notebooklm/
.adk/
**/*.sqlite3
*.db-journal

# Python, Virtual Environments & dbt
.venv/
spark_env/
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.jupyter/
target/
dbt_packages/
logs/

# Lab Provisioner & Terraform Runtime Artifacts
**/trash/
lab-packs/.lab-env.json
lab-packs/part1-troubleshoot/
lab-packs/part2-qualification/
lab-packs/part3-medallion/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Protected Lab Evaluator Artifacts
lab-evaluation-verifier/**/*.zip
lab-evaluation-verifier/**/trash/
lab-evaluation-verifier-bkp/