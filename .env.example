# L400 Agentic Data Engineering — Example Environment Configuration
# Copy this file to `.env` for local runs (`cp .env.example .env`), or run `./lab-packs/deploy-all-labs.sh` to auto-seed `.env`.
# NOTE: `.env` is ignored by Git per `.agents/rules/zero_secrets_policy.md`.
# NEVER place service account JSON keys, private keys, or OAuth tokens in `.env`.

PROJECT_ID=your-gcp-project-id
GCP_PROJECT=your-gcp-project-id
GCP_PROJECT_ID=your-gcp-project-id
P1_PROJECT_ID=your-gcp-project-id-p1
P2_PROJECT_ID=your-gcp-project-id-p2
P3_PROJECT_ID=your-gcp-project-id-p3
GCP_REGION=us-central1
REGION=us-central1
ENV=dev
