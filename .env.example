# L400 Agentic Data Engineering — Example Environment Configuration
# Copy this file to `.env` for local runs (`cp .env.example .env`).
# NOTE: `.env` is ignored by Git per `.gemini/rules/zero_secrets_policy.md`.
# NEVER place service account JSON keys, private keys, or OAuth tokens in `.env`.

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
ENV=dev
